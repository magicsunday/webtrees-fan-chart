declare(strict_types=1);

use Fisharebest\Webtrees\View;
use MagicSunday\Webtrees\FanChart\Configuration;
use MagicSunday\Webtrees\FanChart\Model\Node;

/**
 * @var string        $javascript
 * @var Configuration $configuration
 * @var string        $id                The unique chart ID
 * @var array         $chartParams
 * @var string[]      $exportStylesheets A list of stylesheets used by SVG export
 * @var Node|null     $data              The chart data tree, JSON-serialized into the FanChart "data" option
 */

// The script is inline, so the tag and quote characters of the data are written as escapes. Free text
// such as a name must not open a comment or a script element inside the script.
$jsonFlags = \JSON_HEX_TAG | \JSON_HEX_AMP | \JSON_HEX_APOS | \JSON_HEX_QUOT;
?>

<div class="webtrees-fan-chart-container" id="webtrees-fan-chart-container-<?php echo $id; ?>"></div>

<?php View::push('javascript'); ?>
<script type="module">

import(<?php echo json_encode($javascript, $jsonFlags); ?>).then(({ FanChart }) => {
    const opts = (typeof WebtreesFanChart !== "undefined" && WebtreesFanChart.chartOptions) || {};

    new FanChart(
        "#webtrees-fan-chart-container-<?php echo $id; ?>",
        {
            labels: <?php echo json_encode($chartParams['labels'], $jsonFlags); ?>,
            rtl: <?php echo json_encode($chartParams['rtl'], $jsonFlags); ?>,
            cssFiles: <?php echo json_encode($exportStylesheets, $jsonFlags); ?>,

            get generations() {
                return opts.generations ?? <?php echo $configuration->getGenerations(); ?>;
            },

            get fanDegree() {
                return opts.fanDegree ?? <?php echo json_encode($configuration->getFanDegree(), $jsonFlags); ?>;
            },

            get fontScale() {
                return opts.fontScale ?? <?php echo json_encode($configuration->getFontScale(), $jsonFlags); ?>;
            },

            get hideEmptySegments() {
                return opts.hideEmptySegments ?? <?php echo json_encode($configuration->getHideEmptySegments(), $jsonFlags); ?>;
            },

            get showFamilyColors() {
                return opts.showFamilyColors ?? <?php echo json_encode($configuration->getShowFamilyColors(), $jsonFlags); ?>;
            },

            get paternalColor() {
                return opts.paternalColor ?? <?php echo json_encode($configuration->getPaternalColor(), $jsonFlags); ?>;
            },

            get maternalColor() {
                return opts.maternalColor ?? <?php echo json_encode($configuration->getMaternalColor(), $jsonFlags); ?>;
            },

            get showPlaces() {
                return opts.showPlaces ?? <?php echo json_encode($configuration->getShowPlaces(), $jsonFlags); ?>;
            },

            get showParentMarriageDates() {
                return opts.showParentMarriageDates ?? <?php echo json_encode($configuration->getShowParentMarriageDates(), $jsonFlags); ?>;
            },

            get innerArcs() {
                return opts.innerArcs ?? <?php echo json_encode($configuration->getInnerArcs(), $jsonFlags); ?>;
            },

            get showImages() {
                return opts.showImages ?? <?php echo json_encode($configuration->getShowImages(), $jsonFlags); ?>;
            },

            get showNames() {
                return opts.showNames ?? <?php echo json_encode($configuration->getShowNames(), $jsonFlags); ?>;
            },

            get showDescendants() {
                return opts.showDescendants ?? <?php echo json_encode($configuration->getShowDescendants(), $jsonFlags); ?>;
            },

            showDetailPanel: <?php echo json_encode($configuration->getShowDetailPanel(), $jsonFlags); ?>,
            showSilhouettes: <?php echo json_encode($chartParams['showSilhouettes'], $jsonFlags); ?>,
            nameAbbreviation: <?php echo json_encode($chartParams['nameAbbreviation'], $jsonFlags); ?>,
            data: <?php echo json_encode($data, $jsonFlags); ?>
        }
    );
});

</script>
<?php View::endpush(); ?>
