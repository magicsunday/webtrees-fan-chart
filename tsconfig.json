{
    "extends": "@magicsunday/coding-standard/tsconfig/base",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"],
        "types": ["jest"],
        "paths": {
            "resources/js/modules/*": ["./resources/js/modules/*"]
        }
    },
    "include": ["resources/js/modules/**/*.js"],
    "exclude": ["node_modules"]
}
