{
    "$schema": "./.build/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php://stdout"
    },
    "tmpDir": ".build/cache/infection",
    // Count a timed-out mutant as escaped, so a mutation that made the suite hang
    // does not inflate the score.
    "timeoutsAsEscaped": true,
    // No minimum score here on purpose. The full run only reports, and the gate is the
    // changed-lines script `composer ci:test:php:infection:changed`. A fixed floor over
    // the whole tree rewards tests that only kill a mutant in a getter, a literal, a
    // default or a call order. No `maxTimeouts` limit either, because the timeout count
    // varies with machine load.
    "mutators": {
        "@default": true,
        // The labels of the chart parameters are literal texts that the page reads, and the
        // testing policy of AGENTS.md excludes a test that only pins a label. Removing an
        // entry of that array is therefore answered here and not with a test of its value.
        "ArrayItemRemoval": {
            "ignore": [
                "MagicSunday\\Webtrees\\FanChart\\Module::getChartParameters"
            ]
        }
    }
}
